# Скопируй этот файл в .env и заполни своими значениями.
# .env никогда не должен попадать в git (он уже в .gitignore).

# --- Telegram ---
TELEGRAM_TOKEN=1234567890:AAExampleTokenFromBotFather
CHANNEL_ID=@my_sports_channel

# --- RSS-ленты через запятую ---
RSS_URLS=https://example.com/sport/rss,https://example2.com/rss

# Сколько новостей публиковать за один запуск
MAX_NEWS_PER_RUN=3

# --- Генерация картинок: pollinations (без ключа, по умолчанию) | huggingface | cloudflare | none ---
IMAGE_PROVIDER=pollinations

HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-1-schnell

# --- Переписывание текста живым языком (необязательно, но рекомендуется) ---
# Бесплатный ключ: https://aistudio.google.com/apikey
# Без ключа новости публикуются как есть, текстом с RSS-ленты (на языке источника).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Твой личный Telegram ID ---
# Нужен для статистики в личку И для переписки с ботом про оформление/
# аватарку/тон текста/частоту публикаций (admin_agent.py) — без него бот
# не отвечает вообще никому, даже тебе, это осознанная защита.
# Узнать свой ID можно, написав боту @userinfobot
ADMIN_CHAT_ID=

# --- Бренд-бук ---
BRAND_PRIMARY_COLOR=#1E3A8A
BRAND_BACKGROUND_COLOR=#0F172A
BRAND_TEXT_COLOR=#FFFFFF
BRAND_FONT_PATH=assets/fonts/brand_font.ttf
BRAND_FONT_SIZE=48
BRAND_LOGO_PATH=assets/logo.png
BRAND_LOGO_WIDTH_RATIO=0.18
BRAND_LOGO_MARGIN=24
BRAND_IMAGE_STYLE=боке, глубина резкости, естественный свет, телеобъектив, photojournalism, Getty Images style
